# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration (Choose individual parameters OR DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_management
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_SSL=false
# Or use cloud connection string:
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Authentication & Security
JWT_SECRET=change_this_to_a_secure_random_secret_string
JWT_EXPIRES_IN=1d
